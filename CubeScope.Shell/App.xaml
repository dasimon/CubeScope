<!-- Explicit ShutdownMode, and NOT OnMainWindowClose: task 3 wires an ASYNC
     handler on Closed that stops and releases the web host before exiting.
     OnMainWindowClose would start the WPF shutdown as soon as the window closes,
     without waiting for that handler — the process could die before the container's
     Dispose, hence before the SSAS trace's Stop()/Drop(). ArreterServeurAsync, and
     only it, calls Shutdown(). -->
<Application x:Class="CubeScope.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown" />
