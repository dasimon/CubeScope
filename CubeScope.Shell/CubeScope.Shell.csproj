<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CubeScope.Shell</RootNamespace>
    <!-- Settled decision: a single executable "cubescope.exe". The name moves here from
         CubeScope.Server, which is now only a library. -->
    <AssemblyName>cubescope</AssemblyName>
    <!-- Exe icon = same visual identity as favicon.svg (isometric emerald cube). -->
    <ApplicationIcon>..\CubeScope.Server\cubescope.ico</ApplicationIcon>
    <!-- ALSO embeds the native DLLs (e_sqlite3, msalruntime, WebView2Loader…) in
         the exe and self-extracts them at startup → the exe alone is enough. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compresses what the single file bundles (after Lucarne). Measured on 2026-11-05, v0.19.0,
         exe copied alone into a blank folder: 206 MB down to 88 MB; start-up unchanged once the
         file has been launched before (window ~1.1 s, API ~2.1 s either way; the first launch of
         a new file takes ~15 s either way); about 84 MB more private memory, since compressed
         assemblies are inflated into memory instead of being mapped from the file. Halving the
         download matters twice: once by hand, once for every built-in update. The stamp check in
         release.yml reads the uncompressed cubescope.dll in obj/ for that reason. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CubeScope.Server\CubeScope.Server.csproj" />
  </ItemGroup>

  <!-- The update channel, fixed when the executable is built (after Lucarne). The built-in update
       looks for a newer release only if this assembly — the entry assembly — carries
       AssemblyMetadata("UpdateChannel", "release"). Only .github/workflows/release.yml passes
       -p:UpdateChannel=release (a test holds it there); a source build, the dev loop and CI carry
       no stamp, so a developer's binary is never overwritten by a release. Read by UpdateBuild. -->
  <ItemGroup Condition="'$(UpdateChannel)' != ''">
    <AssemblyMetadata Include="UpdateChannel" Value="$(UpdateChannel)" />
  </ItemGroup>

</Project>
