<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cubescope-server</AssemblyName>
    <!-- Jamais publié : c'est l'hôte console de la boucle de dev et des tests.
         L'artefact distribué est CubeScope.Shell. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CubeScope.Server\CubeScope.Server.csproj" />
  </ItemGroup>

</Project>
