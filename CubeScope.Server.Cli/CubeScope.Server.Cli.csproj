<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cubescope-server</AssemblyName>
    <!-- Never published: this is the console host for the dev loop and the tests.
         The distributed artifact is CubeScope.Shell. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CubeScope.Server\CubeScope.Server.csproj" />
  </ItemGroup>

</Project>
