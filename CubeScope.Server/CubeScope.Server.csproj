<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CubeScope.Core\CubeScope.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- On publish (or -p:EmbedSpa=true): build the Vue SPA then embed the dist
       as EmbeddedResource (logical prefix "spa/") INSIDE the assembly. Served at runtime
       by EmbeddedSpaFileProvider → a TRULY self-contained, movable exe (otherwise the single-file
       looked for wwwroot NEXT TO the exe = ContentRoot = 404 once moved).
       `_IsPublishing` covers `dotnet publish` without a flag. In a normal build/dev: nothing
       (no npm in CI; the SPA is served by Vite through the proxy). The resource glob
       is done INSIDE the target, after npm, so that dist exists by the time of CoreCompile. -->
  <Target Name="EmbedSpa"
          BeforeTargets="PrepareForBuild"
          Condition="('$(EmbedSpa)' == 'true' or '$(_IsPublishing)' == 'true') and '$(_SpaEmbedded)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="..\CubeScope.Web" />
    <PropertyGroup>
      <_SpaEmbedded>true</_SpaEmbedded>
    </PropertyGroup>
    <ItemGroup>
      <!-- *.*: files only (the **\* glob would also match folders).
           Intermediate item `_SpaFile` + QUALIFIED metadata `%(_SpaFile.…)`: on a
           self-referencing Include, `%(Filename)` evaluates to empty → every LogicalName
           becomes "spa/" (CS1508 collision). Going through a qualified source item
           expands the per-file path correctly. -->
      <_SpaFile Include="..\CubeScope.Web\dist\**\*.*" />
      <EmbeddedResource Include="@(_SpaFile)">
        <LogicalName>spa/%(_SpaFile.RecursiveDir)%(_SpaFile.Filename)%(_SpaFile.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
